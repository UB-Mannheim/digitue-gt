    <TextRegion id="eSc_textblock_c07d24f0"  custom="structure {type:text;}">
      <Coords points="1193,596 3097,618 3097,3033 3054,3662 1150,3619 1193,596"/>
      <TextLine id="eSc_line_122bcd65" custom="structure {type:default;}">
        <Coords points="1204,593 1179,593 1179,637 1177,666 3083,669 3089,650 3086,615 2861,615 2834,612 2400,610 2373,607 2156,607 2129,604 1912,604 1885,601 1451,599 1423,596 1206,596"/>
        <Baseline points="1179,637 3089,650"/>
        <TextEquiv>
          <Unicode>ſo lang biß ob angezaigt ſumma achtmal hundert tuſent guldin bezalt vnd abgeloͤßt iſt. Daneben ſollen</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_2d6f2a87" custom="structure {type:default;}">
        <Coords points="1177,710 3083,723 3089,702 3086,664 1179,653 1179,691"/>
        <Baseline points="1179,691 3089,702"/>
        <TextEquiv>
          <Unicode>die Prelaten/ ſtifft doͤſter vnd ob beſtimpt ampter iedes iars geben als vil by den ſelben allen erlangt wer</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_b656f269" custom="structure {type:default;}">
        <Coords points="1177,764 3083,775 3089,753 3086,710 1179,704 1179,745"/>
        <Baseline points="1179,745 3089,753"/>
        <TextEquiv>
          <Unicode>den mag/ vnd was alſo von den Prelaten vnd amptern ierlichs geuelt/ das ſoll inn die achtmalhundert</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_8659c45a" custom="structure {type:default;}">
        <Coords points="1179,821 3083,832 3089,805 3086,764 1182,756 1182,797"/>
        <Baseline points="1182,797 3089,805"/>
        <TextEquiv conf="0.9893744468688965">
          <Unicode>tuſent guldin gerechnet vnd daran abgezogen. Alſo was zuͦ ieder zyt iars von ſollicher ſumma achtmal</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_19bc3c8a" custom="structure {type:default;}">
        <Coords points="1587,797 1546,797 1505,797 1465,797 1424,797 1383,797 1343,797 1302,797 1261,797 1221,797 1180,797 1180,845 1176,870 3076,890 3085,858 3080,809 1652,797 1628,797"/>
        <Baseline points="1182,848 3089,862"/>
        <TextEquiv>
          <Unicode>hundert tuſent guldin der verſchrybnen gülten ob beſtimpt abgeloͤſt werden/ die ſelben ſollen in hertzog</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_5bbc8bfa" custom="structure {type:default;}">
        <Coords points="1208,841 1184,841 1184,890 1180,919 3076,943 3085,910 3080,862 2698,858 2486,858 2458,854 1835,854 1794,849 1225,849"/>
        <Baseline points="1185,894 3089,913"/>
        <TextEquiv>
          <Unicode>Ulrichs ſeckel allzyt geuallen. Vnd zuͦ empfahung ſollicher ierlichen raichung als nemlich der erſten</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_8745bf30" custom="structure {type:default;}">
        <Coords points="1176,898 1176,951 1172,980 3072,992 3080,963 3076,910 2722,910 2698,906 2356,906 2348,902"/>
        <Baseline points="1179,954 3083,965"/>
        <TextEquiv>
          <Unicode>fünffiarn auch nachuolgender landtſteur der achtmal hundert tuſent guldin/ ſollen ſunder perſonen ſo</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_78e9e415" custom="structure {type:default;}">
        <Coords points="1177,1019 3075,1035 3081,1011 3078,970 1179,962 1179,1003"/>
        <Baseline points="1179,1003 3081,1011"/>
        <TextEquiv>
          <Unicode>vor mals mit amptern ynnemens vnd vßgebens nit beladen ſindt/ von hertzog Vlrichen vnd der landt⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_f5d11c55" custom="structure {type:default;}">
        <Coords points="1172,1085 3072,1093 3080,1065 3076,1012 1176,1004 1176,1057"/>
        <Baseline points="1179,1060 3083,1068"/>
        <TextEquiv>
          <Unicode>ſchafft/ mit verpflichtung geordnet werden/ ſolliche raichung der erſten fünff iar fürter zuͦ den wachen</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_82b83b7b" custom="structure {type:default;}">
        <Coords points="2112,1061 2071,1061 2030,1061 1990,1061 1949,1061 1908,1061 1868,1061 1827,1061 1786,1061 1746,1061 1705,1061 1664,1061 1623,1061 1583,1061 1542,1061 1501,1061 1461,1061 1420,1061 1379,1061 1339,1061 1298,1061 1257,1061 1216,1061 1176,1061 1176,1106 1172,1126 3072,1146 3080,1114 3076,1065 2153,1065"/>
        <Baseline points="1179,1108 3083,1116"/>
        <TextEquiv>
          <Unicode>den ſchulden vnd bezalung der gülten/ vnd nach mals die landtſteur zuͦ abloͤßung der zinßen vnd gülten</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_e86815ab" custom="structure {type:default;}">
        <Coords points="2132,1110 1807,1110 1786,1110 1746,1110 1705,1110 1664,1110 1623,1110 1583,1110 1542,1110 1501,1110 1461,1110 1420,1110 1379,1110 1339,1110 1298,1110 1257,1110 1216,1110 1176,1110 1176,1159 1172,1187 3072,1195 3080,1167 3076,1118 2442,1114 2153,1114"/>
        <Baseline points="1179,1160 3083,1171"/>
        <TextEquiv>
          <Unicode>da mit das fürſtenthumb beſchwerdt iſt/ vnnd nit anders wohin trewlich zuwenden vnd zuͦkoͤren/ vnnd</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_8dd6246a" custom="structure {type:default;}">
        <Coords points="2132,1163 1807,1163 1786,1163 1746,1163 1705,1163 1664,1163 1623,1163 1583,1163 1542,1163 1501,1163 1461,1163 1420,1163 1379,1163 1339,1163 1298,1163 1257,1163 1216,1163 1176,1163 1176,1211 1172,1236 3068,1252 3076,1224 3072,1171 2437,1167 2153,1167"/>
        <Baseline points="1177,1214 3078,1225"/>
        <TextEquiv>
          <Unicode>dern halb alle iaur gemeltem hertzog Ulrichen vnnd der Lanndtſchafft vffrichtlich/ redlich rechnung</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_9bfe7dd2" custom="structure {type:default;}">
        <Coords points="1786,1215 1746,1215 1705,1215 1664,1215 1623,1215 1583,1215 1542,1215 1501,1215 1461,1215 1420,1215 1379,1215 1339,1215 1298,1215 1257,1215 1216,1215 1176,1215 1176,1264 1172,1285 3076,1301 3085,1272 3080,1220 3048,1215 3048,1224 2478,1224 2437,1220 1827,1220"/>
        <Baseline points="1179,1268 3089,1276"/>
        <TextEquiv>
          <Unicode>zuͦthon. Unnd hieruff ſoll hertzog Ulrich vß ſundern gnaden die er zuͦ ſyner lanndtſchafft tregt/ den</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_bb49588d" custom="structure {type:default;}">
        <Coords points="1174,1336 3078,1350 3083,1328 3081,1287 1177,1274 1177,1314"/>
        <Baseline points="1177,1314 3083,1328"/>
        <TextEquiv>
          <Unicode>landtſchaden/ ſo bißher inn gebrauch geweßt/ ietzo abthon vnd nachlaſſen/ alſo das der hinfuͤr nit mer</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_1a4c1dfc" custom="structure {type:default;}">
        <Coords points="1177,1390 3078,1404 3083,1379 3083,1336 1179,1323 1179,1366"/>
        <Baseline points="1179,1366 3083,1379"/>
        <TextEquiv conf="0.9943728110577801">
          <Unicode>begert werden oder ſein ſoll. Doch das diſe nachlaſſung des lanndtſchades vnd die bezalung der erſten</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_4fa274c0" custom="structure {type:default;}">
        <Coords points="1176,1447 3068,1464 3076,1435 3076,1382 1180,1366 1180,1419"/>
        <Baseline points="1182,1423 3078,1436"/>
        <TextEquiv conf="0.9894145156747551">
          <Unicode>zwai vnnd zwaintzig tauſent guldin ains mit dem andern zuͦgeen vnnd beſchehen. Der haubtkrieg</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_6d523aff" custom="structure {type:default;}">
        <Coords points="1177,1504 3081,1504 3083,1480 3081,1439 1177,1434 1177,1474"/>
        <Baseline points="1177,1474 3083,1480"/>
        <TextEquiv>
          <Unicode>halb ſo die zuͦ rettung lanndt/ leut vnd ſyner hertzog Ulrichs verwandten zuͦ hanndthabung ſeiner ober</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_6be764c0" custom="structure {type:default;}">
        <Coords points="3007,1476 2967,1476 2926,1476 2885,1476 2844,1476 2804,1476 2763,1476 2722,1476 2682,1476 2641,1476 2600,1476 2560,1476 2519,1476 2478,1476 2437,1476 2397,1476 2356,1476 2315,1476 2275,1476 2234,1476 2193,1476 2153,1476 2112,1476 2071,1476 2030,1476 1990,1476 1949,1476 1908,1476 1868,1476 1827,1476 1786,1476 1746,1476 1705,1476 1664,1476 1623,1476 1583,1476 1542,1476 1501,1476 1461,1476 1420,1476 1379,1476 1339,1476 1298,1476 1257,1476 1216,1476 1176,1476 1176,1525 1172,1545 3080,1561 3089,1533 3085,1520 3048,1476"/>
        <Baseline points="1179,1529 3092,1534"/>
        <TextEquiv>
          <Unicode>vnnd herlichait/ auch gerechtigkait hilff vnnd haltung ſeiner ainung bißher angenomen vnd beſchloſ</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_015db034" custom="structure {type:default;}">
        <Coords points="1172,1525 1172,1577 1168,1606 3072,1614 3080,1586 3076,1533 2148,1533 2108,1529 1212,1529"/>
        <Baseline points="1174,1580 3083,1588"/>
        <TextEquiv>
          <Unicode>ſen. Vnnd der ihenen ſo er fürter ſyns geuallens dem fürſtenthumb zuͦ gut annemen vnnd thon mag/</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_3b05ca5e" custom="structure {type:default;}">
        <Coords points="1212,1577 1176,1577 1176,1630 1172,1659 3072,1667 3080,1638 3076,1586 2153,1586 2112,1581 1216,1581"/>
        <Baseline points="1177,1632 3081,1642"/>
        <TextEquiv>
          <Unicode>fürgenomen wolten werden/ ſo ſoll das geſchehen mit rat vnnd wiſſen gemainer Lanndtſchafft. Wur</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_a143d10b" custom="structure {type:default;}">
        <Coords points="1212,1630 1176,1630 1176,1679 1172,1699 3072,1720 3080,1687 3076,1638 2153,1638 2112,1634 1216,1634"/>
        <Baseline points="1177,1683 3083,1691"/>
        <TextEquiv>
          <Unicode>de aber hertzog Vlrich vſſerthalb der obgemelten ſtuck ainich krieg fürnemen/ vnnd iemandt vß freunt⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_f429a401" custom="structure {type:default;}">
        <Coords points="1212,1675 1176,1675 1176,1732 1172,1764 3072,1769 3080,1740 3076,1687 2153,1687 2112,1683 1216,1683"/>
        <Baseline points="1177,1735 3083,1743"/>
        <TextEquiv>
          <Unicode>ſchafft oder ſunſt fürſchub oder hilff thon/ ſo ſoll das ſelbig geſchehen mit rat wiſſen vnnd willen ge⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_563d6674" custom="structure {type:default;}">
        <Coords points="2132,1736 1176,1736 1176,1785 1172,1809 3076,1821 3085,1793 3080,1740 3048,1736 3048,1740 2153,1740"/>
        <Baseline points="1177,1786 3086,1797"/>
        <TextEquiv>
          <Unicode>mainer Landtſchafft/ ſouer anders hertzog Vlrich von inen hilff haben woͤlt. Vnd ſol inn allen ſtucken</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_8cc76c5c" custom="structure {type:default;}">
        <Coords points="1208,1777 1172,1777 1172,1838 1168,1862 3072,1878 3080,1850 3076,1797 2694,1793 2148,1793 2108,1789 1212,1789"/>
        <Baseline points="1174,1840 3081,1851"/>
        <TextEquiv>
          <Unicode>hertzog Vlrich/ wie ſyne voreltern/ die lifferung geben/ des glych die Landtſchafft mit irn lyben/ fuͤrung</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_6f83985d" custom="structure {type:default;}">
        <Coords points="1212,1838 1176,1838 1176,1886 1172,1919 3072,1931 3080,1899 3076,1850 2478,1850 2437,1846 1827,1846 1786,1842 1216,1842"/>
        <Baseline points="1177,1889 3083,1903"/>
        <TextEquiv>
          <Unicode>vnd andern dienen/ wie von alter herkomen/ vnd by hertzog Ulrichs voreltern auch beſchehen iſt/ alles</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_ac19649a" >
        <Coords points="1208,1886 1172,1886 1172,1935 1168,1968 3072,1984 3080,1952 3076,1903 2474,1899 2462,1895 1823,1895 1794,1891 1212,1891"/>
        <Baseline points="1174,1938 3083,1954"/>
        <TextEquiv>
          <Unicode>ongeuarlich. Unnd ob ain lands krieg obgemelter maß angenomen/ vnd man hilff darzuͦ thon</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_4896e394" custom="structure {type:default;}">
        <Coords points="1432,1939 1168,1939 1168,1992 1164,2013 3068,2037 3076,2008 3072,1956 2592,1952 2588,1947 2063,1947 2055,1943 1452,1943"/>
        <Baseline points="1171,1995 3078,2011"/>
        <TextEquiv>
          <Unicode>mießt/ das dann die ſelbig zyt diße ietzige angenomne hilff ainen ſtillſtandt haben ſoll/ doch on ab</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_04bcd17f" custom="structure {type:default;}">
        <Coords points="1204,1984 1168,1984 1168,2045 1164,2069 3068,2090 3076,2061 3072,2008 2633,2008 2592,2004 2144,2004 2104,2000 1656,2000 1615,1996 1208,1996"/>
        <Baseline points="1171,2049 3078,2063"/>
        <TextEquiv>
          <Unicode>brüchlich dißem zuͦſagen biß zuͦ endt der kriegs hilff. Der geſtalt ſoll es auch gehalten werden/ wo ain</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_3d1f5cc5" custom="structure {type:default;}">
        <Coords points="1164,2045 1164,2098 1159,2126 3060,2143 3068,2114 3064,2061 2629,2061 2588,2057 2140,2057 2100,2053 1652,2053 1611,2049 1204,2049"/>
        <Baseline points="1168,2101 3070,2117"/>
        <TextEquiv>
          <Unicode>regierender fürſt (das got verhiet) gefangen wurde/ vnd ſol die Lanndtſchafft alls dann zuͦ erledigung</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_782a2554" custom="structure {type:default;}">
        <Coords points="1204,2098 1168,2098 1168,2151 1164,2179 3064,2187 3072,2163 3068,2098 3048,2098 3040,2114 2592,2114 2551,2110 2144,2110 2104,2106 1656,2106 1615,2102 1208,2102"/>
        <Baseline points="1171,2152 3073,2166"/>
        <TextEquiv>
          <Unicode>irs regierenden lanndtsfürſten trewlich helffen/ vnnd ſolliche hilff mit irem rat vnnd wiſſen fuͤrgeno</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_ef1cc330" custom="structure {type:default;}">
        <Coords points="1164,2151 1164,2200 1159,2224 3064,2244 3072,2216 3068,2163 2466,2163 2425,2159 1815,2159 1774,2155 1204,2155"/>
        <Baseline points="1168,2201 3073,2217"/>
        <TextEquiv>
          <Unicode>men werden/ wie dann by hertzog Vlrichs voreltern geſchehen iſt. Damit auch der gemain man</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_e1ffc496" custom="structure {type:default;}">
        <Coords points="1192,2200 1155,2200 1155,2252 1151,2281 3060,2297 3068,2265 3064,2220 2621,2216 2612,2212 2132,2212 2112,2208 1644,2208 1607,2204 1196,2204"/>
        <Baseline points="1158,2255 3070,2269"/>
        <TextEquiv>
          <Unicode>den laſt/ ſo vil lydenlicher vnnd williger tragen/ ſo ſoll inen hertzog Ulrich ainen fryen zug gnedigklich</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_73521b42" custom="structure {type:default;}">
        <Coords points="1204,2252 1168,2252 1168,2305 1164,2322 3064,2346 3072,2322 3068,2269 2470,2265 2458,2261 1819,2261 1790,2257 1208,2257"/>
        <Baseline points="1171,2307 3075,2323"/>
        <TextEquiv>
          <Unicode>vergünden vnnd zuͦlaſſen. Doch alſo/ das inn den nechſten fünff iarn niemants ron der Lanndtſchafft</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_ff2c026a" custom="structure {type:default;}">
        <Coords points="1204,2301 1168,2301 1168,2354 1164,2374 3072,2399 3080,2370 3076,2318 3040,2313 3040,2322 2633,2322 2592,2318 2144,2318 2104,2313 1656,2313 1615,2309 1208,2309"/>
        <Baseline points="1171,2355 3081,2372"/>
        <TextEquiv>
          <Unicode>vß dem lanndt ziehen/ woͤlt aber iemands inn ſolcher zyt ſyne kindt vß ſollichen/ hyraten/ der ſoll des</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_f929d995" custom="structure {type:default;}">
        <Coords points="1200,2350 1164,2350 1164,2403 1159,2427 3064,2448 3072,2419 3072,2370 2629,2370 2588,2366 2140,2366 2100,2362 1652,2362 1611,2358 1204,2358"/>
        <Baseline points="1168,2407 3075,2423"/>
        <TextEquiv>
          <Unicode>macht haben mit abzug des zehenden pfennigs/ aller hab die das vßgeſteurt kindt hinauß nimpt/ vnnd</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_a3ce9c79" custom="structure {type:default;}">
        <Coords points="1640,2407 1164,2407 1164,2460 1159,2480 3072,2505 3080,2476 3080,2419 3036,2415 3036,2419 2629,2419 2596,2415 2140,2415 2116,2411 1652,2411"/>
        <Baseline points="1168,2461 3081,2477"/>
        <TextEquiv>
          <Unicode>ſollicher abzug des zehenden pfennings ſol hertzog Ulrichen inn den fünff iaurn inn ſeinen ſeckel/ geual</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_628929f4" custom="structure {type:default;}">
        <Coords points="1200,2456 1164,2456 1164,2509 1159,2541 3064,2553 3072,2525 3068,2476 2629,2476 2588,2472 2140,2472 2100,2468 1652,2468 1611,2464 1204,2464"/>
        <Baseline points="1168,2510 3075,2529"/>
        <TextEquiv conf="0.9892884742240516">
          <Unicode>len. Welcher aber nach vßgang ſollicher fünff iarn inn den andern nechßtuolgenden fünffiaurn hinuß</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_91781e66" custom="structure {type:default;}">
        <Coords points="1628,2513 1164,2513 1164,2562 1159,2590 3068,2606 3076,2574 3076,2521 3036,2517 3036,2525 2629,2525 2588,2521 2140,2521 2100,2517 1652,2517"/>
        <Baseline points="1168,2562 3078,2578"/>
        <TextEquiv>
          <Unicode>ziehen/ oder ſeine kindt hinuß hyraten woͤlt/ der ſoll das zuͤthon macht haben/ mit abzug des zehenden</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_fe63050d" custom="structure {type:default;}">
        <Coords points="1159,2643 3064,2659 3072,2631 3072,2582 1164,2566 1164,2614"/>
        <Baseline points="1168,2616 3075,2632"/>
        <TextEquiv>
          <Unicode>pfennings wie obſteet. Welcher aber nach vßgang ietzgemelter zehen iaurn inn nechßtuolgenden zehen</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_843ad536" custom="structure {type:default;}">
        <Coords points="1200,2614 1164,2614 1164,2663 1159,2688 3064,2712 3072,2684 3072,2635 2629,2631 2621,2627 2140,2627 2120,2623 1652,2623 1615,2618 1204,2618"/>
