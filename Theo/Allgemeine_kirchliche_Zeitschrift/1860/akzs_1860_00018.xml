        <Coords points="60,1970 1424,1996 1424,2046 1420,2061 58,2027 60,2018"/>
        <Baseline points="60,2018 1424,2046"/>
        <TextEquiv>
          <Unicode>Einen fertig gebrachten Beſitz von kirchlichen Lehrſätzen, Anordnungen und</Unicode>
