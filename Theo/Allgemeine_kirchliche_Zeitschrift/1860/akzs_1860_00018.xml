      </TextLine>
      <TextLine id="eSc_line_2b24f1e8" >
        <Coords points="89,315 1453,339 1455,384 1450,395 87,380 89,369"/>
        <Baseline points="89,369 1455,384"/>
        <TextEquiv>
          <Unicode>daß es wahr ſei. An eine Berechtigung perſönlicher Prüfung der öffent⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_532708f6" >
        <Coords points="89,376 1450,393 1453,439 1448,450 87,434 89,424"/>
        <Baseline points="89,424 1453,439"/>
        <TextEquiv>
          <Unicode>lichen Lehre, des Gottesdienſtes, der Kirchenverfaſſung von Seiten der Ge⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_5b708398" >
        <Coords points="89,430 1455,450 1455,495 1450,508 87,485 89,476"/>
        <Baseline points="89,476 1455,495"/>
        <TextEquiv>
          <Unicode>meindegenoſſen iſt von ſolchen Vorausſetzungen aus auch nicht von fern zu</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_71dcbe86" >
        <Coords points="87,476 1455,500 1455,545 1450,556 84,541 87,530"/>
        <Baseline points="87,530 1455,545"/>
        <TextEquiv>
          <Unicode>denken. Die romaniſchen Völker ſtehen im Großen und Ganzen bis heute</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_d5774999" >
        <Coords points="87,535 1444,554 1450,600 1446,609 82,593 87,580"/>
        <Baseline points="87,580 1450,600"/>
        <TextEquiv>
          <Unicode>noch auf demſelben Standpunkte, den Kaiſer Karl V. im April des Jahres</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_e1feaec1" >
        <Coords points="89,589 1450,609 1450,654 1446,663 87,643 89,635"/>
        <Baseline points="89,635 1450,654"/>
        <TextEquiv>
          <Unicode>1521 zu Worms eingenommen hat. Die Prieſter ſind dazu da, um die reli⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_2a3faeb4" >
        <Coords points="87,643 1450,661 1450,704 1446,715 84,698 87,687"/>
        <Baseline points="87,687 1450,704"/>
        <TextEquiv>
          <Unicode>giöſen Angelegenheiten zu beſorgen, wie die Rechtsgelehrten ſich mit den Rechts⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_c9907729" >
        <Coords points="87,691 1453,713 1453,759 1448,769 84,750 87,739"/>
        <Baseline points="87,739 1453,759"/>
        <TextEquiv>
          <Unicode>fragen, die Aerzte mit dem Geſundheitsweſen zu befaſſen haben. Die Religion</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_14ee56f1" >
        <Coords points="84,737 1448,765 1450,815 1446,828 80,806 84,793"/>
        <Baseline points="84,793 1450,815"/>
        <TextEquiv>
          <Unicode>iſt die Sache eines Standes, nicht die Angelegenheit der Nation, nicht die</Unicode>
        </TextEquiv>
      </TextLine>
