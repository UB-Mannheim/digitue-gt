      <TextLine id="eSc_line_f3b6dbf5" >
        <Coords points="180,167 1459,169 1459,228 1455,237 174,219 178,210"/>
        <Baseline points="178,210 1459,228"/>
        <TextEquiv>
          <Unicode>Die Frage, ob wahr ſei oder nicht, was von den Lehrern der Kirche</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_8eab8a7f" >
        <Coords points="91,217 1455,234 1457,280 1453,289 89,271 91,263"/>
        <Baseline points="91,263 1457,280"/>
        <TextEquiv>
          <Unicode>gelehrt wird, kommt auf dieſem Standpunkte gar nicht in Betracht; oder viel⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_7b85974d" >
        <Coords points="91,267 1453,287 1455,337 1450,350 89,326 91,317"/>
        <Baseline points="91,317 1455,337"/>
        <TextEquiv>
