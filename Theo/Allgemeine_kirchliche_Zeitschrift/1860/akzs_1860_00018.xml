        <Baseline points="150,1968 817,1974 1427,1994"/>
        <TextEquiv>
          <Unicode>Es iſt nun freilich die Wahrheit ein edles Gut; man hat ſie nicht umſonſt.</Unicode>
        </TextEquiv>
      </TextLine>
