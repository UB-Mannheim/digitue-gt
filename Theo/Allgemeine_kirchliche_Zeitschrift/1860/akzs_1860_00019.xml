    <TextRegion id="eSc_textblock_a3aa5073"  >
      <Coords points="1442,1955 974,1972 937,1992 955,2068 920,2079 1068,2122 1105,2227 1425,2253 1416,2451 1122,2451 1079,2486 1059,2442 52,2416 52,2262 119,2253 130,2218 356,2190 337,2007 87,1998 52,1990 43,1937 60,182 1425,200 1442,1955"/>
      <TextLine id="eSc_line_26f892aa" >
        <Coords points="47,169 1418,187 1418,232 1414,243 45,232 47,221"/>
        <Baseline points="47,221 1418,232"/>
        <TextEquiv>
          <Unicode>Der Geiſt der Wahrheit ſelbſt ſträubt ſich gegen jede äußere Form, in die</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_dc9399db" >
        <Coords points="47,230 1414,241 1416,282 1412,295 45,287 47,274"/>
        <Baseline points="47,274 1416,282"/>
        <TextEquiv>
          <Unicode>man ihn ſpannt, weil er ſeinem Weſen nach göttlich, unendlich, ewig ſchöpfer⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_b9e39f5a" >
        <Coords points="47,284 1416,293 1418,337 1416,348 391,354 389,354 45,339 47,328"/>
        <Baseline points="47,328 1418,337"/>
        <TextEquiv>
          <Unicode>kräftig iſt. Die Ueberlieferung umfaßt nur Geſchaffenes; das ſchaffende Element</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_2600bef6" >
        <Coords points="50,330 1416,343 1418,387 1414,398 47,393 50,382"/>
        <Baseline points="50,382 1418,387"/>
        <TextEquiv>
          <Unicode>ſelbſt entzieht ſich ihren Schranken. So kann der Botaniker die Blumen des</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_49978ad7" >
        <Coords points="50,384 1416,398 1418,443 1414,456 47,448 50,437"/>
        <Baseline points="50,437 1418,443"/>
        <TextEquiv>
          <Unicode>Feldes wohl pflücken, trocknen, in ſeinem Herbarium ordnen und zurechtlegen;</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_2656a95d" >
        <Coords points="50,434 1416,452 1418,495 1414,506 47,500 50,487"/>
        <Baseline points="50,487 1418,495"/>
        <TextEquiv>
          <Unicode>aber das Herbarium wird dadurch nicht zu einem grünen Wieſenplatz, und die</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_6b7d5f55" >
        <Coords points="50,487 115,502 565,502 678,491 696,502 1390,495 1418,508 1418,548 1414,561 47,552 50,539"/>
        <Baseline points="50,539 1418,548"/>
        <TextEquiv>
          <Unicode>Bienen ſaugen aus den dürren Blumen keinen Honigſeim. Jede überlieferte</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_7316e852" >
        <Coords points="50,541 1416,558 1418,604 1414,622 47,604 50,593"/>
        <Baseline points="50,593 1418,604"/>
        <TextEquiv>
          <Unicode>Religion gleicht, wenn der lebendige Geiſt der Wahrheit nicht mehr gegenwärtig</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_c9f4a781" >
        <Coords points="47,604 1420,613 1420,654 1416,667 45,659 47,645"/>
        <Baseline points="47,645 1420,654"/>
        <TextEquiv>
          <Unicode>in ihr waltet, einem ſolchen Herbarium; die Lehrſätze werden zu vertrockneten</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_3c3feda1" >
        <Coords points="50,654 1064,665 1066,709 1061,722 45,711 50,698"/>
        <Baseline points="50,698 1066,709"/>
        <TextEquiv>
          <Unicode>Blättern; es fehlt der friſche Duft des blühenden Lebens.</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_2f6fb206" >
        <Coords points="130,702 1412,717 1414,763 1409,780 126,772 130,756"/>
        <Baseline points="130,756 1414,763"/>
        <TextEquiv>
          <Unicode>Der Proteſtantismus iſt nicht ungerecht gegen die Ueberlieferung geweſen,</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_cc792cd5" >
        <Coords points="47,756 1416,767 1418,813 1414,826 45,819 47,806"/>
        <Baseline points="47,806 1418,813"/>
        <TextEquiv>
          <Unicode>wie man ihm öfters vorgeworfen hat. Er unterſchätzt ſie nicht. Wir ehren das</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_31b40b2f" >
        <Coords points="50,811 1414,826 1416,869 1412,880 47,872 50,861"/>
        <Baseline points="50,861 1416,869"/>
        <TextEquiv>
          <Unicode>Wort unſerer Väter, der Reformatoren, als ein wunderbares, gottgeſegnetes Zeu⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_f6c4d4bf" >
        <Coords points="47,867 1416,872 1418,922 1414,933 45,926 47,913"/>
        <Baseline points="47,913 1418,922"/>
        <TextEquiv>
          <Unicode>genwort. Wir erkennen in den Bekenntniſſen, in welchen ſie ihre Glaubens⸗ und</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_beb217d3" >
        <Coords points="50,915 1416,933 1418,972 1414,985 47,978 50,963"/>
        <Baseline points="50,963 670,976 1418,972"/>
        <TextEquiv>
          <Unicode>Lebensüberzeugungen ausſprechen, Vorbilder für unſere Glaubens⸗ und Lebensbe⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_db08ba88" >
        <Coords points="50,967 990,983 1018,983 1188,974 1211,985 1386,976 1418,989 1418,1030 1416,1041 280,1044 278,1044 276,1044 250,1033 108,1041 47,1028 50,1017"/>
        <Baseline points="50,1017 1418,1030"/>
        <TextEquiv>
          <Unicode>kenntniſſe. Wir gehen gern bei allen treuen Lehrern unſerer Kirche in die Schule,</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_27894642" >
        <Coords points="50,1024 598,1024 657,1035 798,1026 1007,1039 1024,1039 1070,1028 1399,1030 1420,1046 1418,1085 1416,1096 248,1096 245,1094 47,1078 50,1070"/>
        <Baseline points="50,1070 1418,1085"/>
        <TextEquiv>
          <Unicode>und wir wiſſen insbeſondere, was wir in trüber Zeit einem Arndt, Spener,</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_c2112b7a" >
        <Coords points="50,1078 1124,1078 1196,1089 1399,1080 1420,1094 1418,1133 1414,1144 47,1135 50,1122"/>
        <Baseline points="50,1122 1418,1133"/>
        <TextEquiv>
          <Unicode>A. .H Francke und vielen anderen geiſtgeſalbten Zeugen zu verdanken haben.</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_36200d2d" >
        <Coords points="47,1124 1416,1146 1418,1187 1414,1204 45,1191 47,1174"/>
        <Baseline points="47,1174 1418,1187"/>
        <TextEquiv>
          <Unicode>Aber wir wiſſen uns an keine menſchliche Ueberlieferung ohne Weiteres gebunden,</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_5ec4b25e" >
        <Coords points="50,1183 1394,1187 1418,1200 1418,1239 1414,1250 47,1237 50,1224"/>
        <Baseline points="50,1224 1418,1239"/>
        <TextEquiv>
          <Unicode>weil wir uns lediglich an die Wahrheit ſelbſt ſchlechthin gebun⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_ac74305a" >
        <Coords points="50,1235 1423,1252 1423,1294 1418,1305 47,1289 50,1278"/>
        <Baseline points="50,1278 1423,1294"/>
        <TextEquiv>
          <Unicode>den wiſſen. Als ächte Proteſtanten proteſtiren wir heute noch gegen jeden</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_c408e540" >
        <Coords points="52,1278 1418,1305 1420,1348 1416,1361 47,1344 52,1331"/>
        <Baseline points="52,1331 1420,1348"/>
        <TextEquiv>
          <Unicode>Verſuch, den Wahrheitstrieb nach irgend einer Richtung zu beſchränken. Es</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_ca78d294" >
        <Coords points="52,1344 1420,1359 1423,1402 1420,1411 446,1413 443,1413 50,1396 52,1387"/>
        <Baseline points="52,1387 1423,1402"/>
        <TextEquiv>
          <Unicode>iſt der Beruf des deutſchen Volkes, die Wahrheit, die ganze, die volle</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_55dc1436" >
        <Coords points="54,1385 254,1398 1013,1396 1418,1411 1420,1457 1416,1468 52,1452 54,1442"/>
        <Baseline points="54,1442 1420,1457"/>
        <TextEquiv>
          <Unicode>Wahrheit zu ergründen, und die ganze iſt die — chriſtliche Wahrheit.</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_5a60c74e" >
        <Coords points="50,1444 152,1455 228,1446 402,1459 1420,1459 1423,1505 1418,1518 47,1509 50,1496"/>
        <Baseline points="50,1496 1423,1505"/>
        <TextEquiv>
          <Unicode>Dieſe aber iſt nach ihrem ewigen Ausgangspunkte in Gott ſelbſt; ihr Urquell</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_72fab81e" >
        <Coords points="52,1502 1420,1520 1423,1563 1418,1574 50,1561 52,1550"/>
        <Baseline points="52,1550 1423,1563"/>
        <TextEquiv>
          <Unicode>liegt jenſeits aller menſchlichen Begriffs⸗ und Lehrbildung; dort will ſie geſchöpft</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_b678f442" >
        <Coords points="50,1550 1418,1572 1420,1613 1416,1626 47,1616 50,1602"/>
        <Baseline points="50,1602 1420,1613"/>
        <TextEquiv>
          <Unicode>ſein; ſie duldet keine Schranken, welche Herkommen, Gewohnheit und Bequem⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_6b14945d" >
        <Coords points="52,1602 161,1613 1153,1611 1425,1624 1425,1668 1420,1681 50,1670 52,1657"/>
        <Baseline points="52,1657 1425,1668"/>
        <TextEquiv>
          <Unicode>lichkeit ihrer Erkenntniß zieht; ſie will da aufgefunden werden, wohin nur die</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_644f606f" >
        <Coords points="50,1659 1425,1676 1427,1722 1423,1735 47,1724 50,1713"/>
        <Baseline points="50,1713 1427,1722"/>
        <TextEquiv>
          <Unicode>edelſten, unerſchrockenſten, opferwilligſten Geiſter vordringen, in der heiligen</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_55fac7a1" >
        <Coords points="54,1716 587,1733 589,1776 585,1785 50,1776 54,1766"/>
        <Baseline points="54,1766 589,1776"/>
        <TextEquiv>
          <Unicode>Region der unſichtbaren Welt.</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_257e9938" >
        <Coords points="132,1772 1431,1779 1433,1829 1429,1842 128,1833 132,1824"/>
        <Baseline points="132,1824 1433,1829"/>
        <TextEquiv>
          <Unicode>Die Deutſchen dürfen es mit einem edeln Stolze von ſich ſagen: ſie ſind</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_f1192f2c" >
        <Coords points="52,1829 1433,1842 1436,1885 1431,1898 50,1885 52,1874"/>
        <Baseline points="52,1874 1436,1885"/>
        <TextEquiv>
          <Unicode>das einzige Volk, das mit der religiöſen Forſchung ungeheuchelten Ernſt gemacht</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_9b1f38a1" >
        <Coords points="50,1881 1425,1892 1427,1940 1425,1948 1164,1959 1161,1959 1159,1959 1157,1959 1144,1948 876,1957 47,1940 50,1929"/>
        <Baseline points="50,1929 1427,1940"/>
        <TextEquiv>
          <Unicode>hat, das bis an die letzten Gränzen der Schöpfung forſchend vorgedrungen iſt</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_5b0dbd69" >
        <Coords points="52,1931 833,1940 835,1992 831,2000 47,1998 52,1981"/>
        <Baseline points="52,1981 835,1992"/>
        <TextEquiv>
          <Unicode>um mit den Worten des Dichters zu reden:</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_c9cc5692" >
        <Coords points="361,1987 942,1985 946,2046 944,2055 361,2055 363,2040"/>
        <Baseline points="363,2040 946,2046"/>
        <TextEquiv>
          <Unicode>Bis dahin wo, — am Strande</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_d52e06e1" >
        <Coords points="361,2040 820,2044 820,2098 818,2109 359,2107 361,2098"/>
        <Baseline points="361,2098 820,2098"/>
        <TextEquiv>
          <Unicode>Seiner Wogen ich lande,</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_b0bd22af" >
        <Coords points="937,2094 939,2094 1068,2109 1068,2164 1064,2168 361,2159 365,2151 363,2096"/>
        <Baseline points="365,2151 1068,2164"/>
        <TextEquiv>
          <Unicode>Anker werf&#39;, wo kein Hauch mehr weht</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_8a09a686" >
        <Coords points="361,2144 1081,2166 1081,2218 1077,2225 356,2207 361,2201"/>
        <Baseline points="361,2201 1081,2218"/>
        <TextEquiv>
          <Unicode>Und der Markſtein der Schöpfung ſteht.</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_1bb54552" >
        <Coords points="130,2198 391,2198 393,2198 419,2207 441,2211 535,2198 537,2198 822,2205 961,2222 972,2222 1079,2211 1166,2233 1423,2238 1423,2285 1420,2294 1253,2301 1251,2301 1248,2301 1201,2288 1159,2288 1037,2292 892,2277 783,2288 783,2285 770,2275 694,2275 530,2279 461,2266 315,2277 126,2259 130,2253"/>
        <Baseline points="130,2253 770,2262 1423,2285"/>
        <TextEquiv>
          <Unicode>England, ſonſt ſo beneidenswerth in feiner Thatkraft und in der Friſche</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_8b364934" >
        <Coords points="47,2242 115,2257 611,2255 837,2262 889,2277 902,2264 970,2264 1072,2281 1111,2279 1188,2272 1188,2275 1196,2281 1198,2285 1418,2290 1418,2340 1416,2351 1253,2353 1251,2353 1248,2353 1246,2353 1242,2346 1233,2340 1146,2351 1105,2335 966,2340 902,2340 863,2329 824,2340 818,2340 800,2333 776,2327 648,2333 589,2322 537,2333 430,2320 404,2322 339,2331 313,2318 289,2329 156,2327 126,2312 45,2312 47,2301"/>
