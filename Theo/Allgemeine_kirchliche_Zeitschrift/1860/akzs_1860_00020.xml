      <TextLine id="eSc_line_d0c8f2a5" >
        <Coords points="352,1744 404,1755 583,1748 646,1748 646,1750 648,1750 657,1759 798,1750 814,1761 894,1753 1238,1768 1238,1813 1234,1831 348,1822 352,1800"/>
