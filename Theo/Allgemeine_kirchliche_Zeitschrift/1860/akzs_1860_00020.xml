        <Coords points="117,1650 613,1644 616,1644 676,1657 687,1657 742,1648 1438,1668 1475,1707 1471,1722 117,1713 119,1689"/>
        <Baseline points="119,1689 1475,1707"/>
        <TextEquiv>
          <Unicode>Begriffes oder einer Vorſtellung gebracht hat. Sie iſt eben Leben, per</Unicode>
