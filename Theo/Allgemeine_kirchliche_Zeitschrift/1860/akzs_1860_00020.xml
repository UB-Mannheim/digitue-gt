        <Baseline points="121,1585 872,1600 1482,1596"/>
        <TextEquiv>
          <Unicode>konnte: „Ich bin die Wahrheit.“ Wie merkwürdig aber, daß Chriſtus die</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_7255c9b4" >
        <Coords points="165,1585 167,1585 169,1585 171,1585 171,1587 174,1587 182,1598 304,1587 330,1587 446,1589 1153,1611 1277,1600 1343,1613 1478,1602 1482,1650 1480,1668 1330,1679 1327,1679 352,1655 322,1655 187,1663 117,1650 121,1637 119,1587"/>
        <Baseline points="121,1637 1005,1655 1482,1650"/>
        <TextEquiv>
          <Unicode>Wahrheit nicht als einen Lehrſatz ausgeſprochen, nicht unter die Formel eines</Unicode>
