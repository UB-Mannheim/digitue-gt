        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_a9942e75" >
        <Coords points="121,1481 1482,1505 1484,1546 1482,1559 1301,1570 1299,1570 117,1552 121,1533"/>
        <Baseline points="121,1533 1484,1546"/>
        <TextEquiv>
          <Unicode>Was iſt Wahrheit? hat einſt Pilatus zu dem geſagt, der darauf erwidern</Unicode>
        </TextEquiv>
      </TextLine>
