      <TextLine id="eSc_line_9a660269" >
        <Coords points="121,1692 182,1703 280,1694 298,1694 365,1705 644,1698 690,1709 742,1700 1186,1716 1188,1759 1186,1774 870,1776 868,1776 770,1763 744,1774 737,1774 731,1772 711,1763 674,1772 650,1774 631,1759 474,1759 119,1766 121,1746"/>
        <Baseline points="121,1746 1188,1759"/>
        <TextEquiv>
          <Unicode>ſönliches Leben. Der Dichter hat Recht, wenn er ſagt:</Unicode>
