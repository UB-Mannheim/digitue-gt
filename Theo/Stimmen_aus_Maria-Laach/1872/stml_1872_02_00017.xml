      <TextLine id="eSc_line_ff837a32" >
        <Coords points="37,614 1311,624 1313,665 1311,682 64,682 33,667 37,659"/>
        <Baseline points="37,659 1313,665"/>
        <TextEquiv>
          <Unicode>niedrigen Gegenſtand unſerer böſen Luſt vorziehen. So wahr alſo Gott</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_bcd25d39" >
        <Coords points="35,671 1313,680 1313,723 1309,731 33,727 35,719"/>
        <Baseline points="35,719 1313,723"/>
        <TextEquiv>
          <Unicode>das höchſte unendliche Gut iſt, ſo wahr iſt die Sünde das höchſte Übel,</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_5d2e60c0" >
        <Coords points="35,725 1311,738 1313,779 1309,787 33,781 35,773"/>
        <Baseline points="35,773 1313,779"/>
        <TextEquiv>
          <Unicode>eine unendliche Schuld. — Hat nun ein Menſch der ewigen Gerechtigkeit</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_11afdd82" >
        <Coords points="28,798 55,783 628,793 667,781 670,781 672,781 674,781 705,793 887,793 897,783 897,781 899,781 901,781 903,781 1309,793 1313,833 1311,845 35,851 35,837"/>
        <Baseline points="35,837 1313,833"/>
        <TextEquiv>
          <Unicode>gegenüber eine ſolche Schuld auf ſich geladen, wie will er ſich derſelben</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_20309c73" >
