      </TextLine>
      <TextLine id="eSc_line_4e5d0ee7" >
        <Coords points="35,1232 35,1180 93,1190 200,1180 219,1180 221,1180 223,1180 227,1180 254,1190 335,1180 337,1180 339,1180 368,1192 653,1192 676,1180 678,1180 680,1180 729,1192 940,1192 951,1182 951,1180 953,1180 955,1180 957,1180 1311,1192 1311,1232 1311,1244 35,1244"/>
        <Baseline points="35,1232 1311,1232"/>
        <TextEquiv>
