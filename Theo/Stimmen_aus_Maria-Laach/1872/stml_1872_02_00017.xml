        <Baseline points="37,891 1313,884"/>
        <TextEquiv>
          <Unicode>entledigen? Etwa dadurch, daß er ſeine Sünde aufrichtig bereut? Auf⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_5ba74a7c" >
        <Coords points="37,948 37,899 1313,905 1313,948 1313,957 37,965"/>
        <Baseline points="37,948 1313,948"/>
        <TextEquiv>
          <Unicode>richtige Reue iſt jedenfalls eine unerläßliche Bedingung, damit ihm Gott</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_5aaa8d77" >
        <Coords points="35,1004 35,953 239,965 388,965 401,953 403,953 405,953 407,953 425,955 465,963 477,957 481,953 483,953 485,953 488,953 550,963 591,953 593,953 595,953 649,963 754,953 756,953 1091,963 1112,953 1114,953 1116,953 1313,965 1313,1004 1313,1015 35,1021"/>
        <Baseline points="35,1004 1313,1004"/>
        <TextEquiv>
          <Unicode>die Sünde vergeben und ihn wieder in Gnaden aufnehmen könne: aber</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_24c863af" >
        <Coords points="35,1017 1311,1011 1313,1062 1313,1073 37,1077"/>
        <Baseline points="37,1062 1313,1062"/>
        <TextEquiv>
          <Unicode>ſie iſt kein Anrecht auf Verzeihung, ſie macht das begangene Unrecht</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_2ab33496" >
