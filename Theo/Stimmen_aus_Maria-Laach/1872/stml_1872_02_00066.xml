      <TextLine id="eSc_line_427181f5" >
        <Coords points="235,2272 595,2272 624,2265 651,2261 674,2265 701,2272 756,2261 789,2263 852,2272 957,2259 1416,2268 1429,2257 1431,2257 1433,2257 1435,2257 1437,2257 1457,2268 1501,2257 1509,2303 1509,2319 1466,2321 1449,2336 1449,2338 1288,2325 1238,2338 1232,2338 1203,2325 1191,2338 1013,2328 996,2330 949,2340 862,2330 829,2342 823,2342 775,2328 744,2342 744,2344 649,2344 647,2342 643,2342 643,2340 628,2328 574,2328 556,2338 552,2342 533,2340 504,2330 330,2340 281,2330 239,2344"/>
        <Baseline points="239,2313 1511,2304"/>
        <TextEquiv>
          <Unicode>Gewalt, von jeder Einmiſchung auszuſchließen; wie wäre er ſonſt im</Unicode>
