          <Unicode>Pflicht ſein, ſchließt nothwendig ein Erziehungsrecht, ein eigentliches,</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_f0204412" >
        <Coords points="227,1931 1503,1922 1509,1962 1507,1976 231,1982 231,1968"/>
        <Baseline points="233,1970 1510,1964"/>
        <TextEquiv>
          <Unicode>ausſchließliches, erzwingbares Recht in ſich, ein Recht auf Gehorſam</Unicode>
        </TextEquiv>
      </TextLine>
