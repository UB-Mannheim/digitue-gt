      <TextLine id="eSc_line_2ac5febe" >
        <Coords points="227,1525 572,1521 624,1532 686,1521 713,1521 781,1532 794,1521 806,1521 864,1532 1153,1519 1195,1519 1197,1519 1205,1519 1269,1529 1282,1519 1284,1519 1286,1519 1288,1519 1290,1519 1292,1519 1304,1532 1441,1532 1499,1519 1505,1569 1503,1581 231,1591 231,1573"/>
        <Baseline points="231,1573 1505,1569"/>
        <TextEquiv>
          <Unicode>Kreiſe der Gemeinde und des Staates entwickeln ſollten, ſo aber, daß</Unicode>
