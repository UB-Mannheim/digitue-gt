        <Baseline points="235,1742 1512,1738"/>
        <TextEquiv>
          <Unicode>gang dieſer Pflicht, etwa auf die Gemeinde oder den Staat, nachge⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_a21def10" >
        <Coords points="229,1753 1505,1749 1509,1798 1505,1815 229,1804 231,1792"/>
        <Baseline points="233,1794 1510,1800"/>
        <TextEquiv>
          <Unicode>wieſen werden müßte, ſich aber nicht nachweiſen läßt. Dieſe Erziehungs⸗</Unicode>
        </TextEquiv>
      </TextLine>
