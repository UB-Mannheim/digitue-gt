        <Baseline points="59,822 1337,829"/>
        <TextEquiv>
          <Unicode>heißt Er noch die ewige Seligkeit, und übergibt ſeine Seele in die Hände</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_7fb0343f" >
        <Coords points="59,831 1331,843 1333,884 1329,897 55,895 59,876"/>
        <Baseline points="59,876 1333,884"/>
        <TextEquiv>
          <Unicode>des Vaters. So berichten die Proceßacten, ſo glauben die Chriſten ſelber.</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_44d6d3a1" >
        <Coords points="140,901 159,886 165,886 223,897 239,886 347,886 357,895 370,886 380,886 392,897 405,886 413,886 457,897 521,886 572,899 591,886 905,897 992,884 994,884 996,884 998,884 1019,897 1127,884 1129,884 1131,884 1133,884 1149,897 1327,899 1331,936 1329,953 148,953 148,940"/>
        <Baseline points="148,940 1331,936"/>
        <TextEquiv>
          <Unicode>Hat Chriſtus die Wahrheit geſagt, oder nicht? — Das iſt nun</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_14eb460c" >
