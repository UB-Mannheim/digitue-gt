        <Baseline points="64,256 1337,260"/>
        <TextEquiv>
          <Unicode>faßt wird. Er hört, wie man Ihn für den verworfenſten Menſchen erklärt</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_589246f2" >
        <Coords points="62,268 1333,272 1335,316 1331,334 59,322 62,312"/>
        <Baseline points="62,312 1335,316"/>
        <TextEquiv>
          <Unicode>und zum Tode verurtheilt: und Er ſetzt ſeiner Erklärung Nichts hinzu.</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_85be8e79" >
