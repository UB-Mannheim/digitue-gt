        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_b4b3c61a" >
        <Coords points="59,1052 59,1006 1333,1011 1333,1052 1333,1062 59,1066"/>
        <Baseline points="59,1052 1333,1052"/>
        <TextEquiv>
          <Unicode>dem Gekreuzigten anbetend niederfallen; dann iſt das Chriſtenthum gött⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_477c7c08" >
        <Coords points="59,1108 59,1066 1333,1070 1333,1108 1333,1122 59,1122"/>
        <Baseline points="59,1108 1333,1108"/>
        <TextEquiv>
