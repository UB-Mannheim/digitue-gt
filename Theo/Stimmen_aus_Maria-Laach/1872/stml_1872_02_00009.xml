        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_3a75984d" >
        <Coords points="62,376 1333,388 1335,430 1333,442 59,442 62,421"/>
        <Baseline points="62,421 1335,430"/>
        <TextEquiv>
          <Unicode>und Er widerruft nicht, Er deutelt an ſeiner Ausſage nicht herum. Im</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_601dea15" >
        <Coords points="560,434 562,434 564,434 618,444 667,434 670,434 672,434 674,434 686,444 690,444 719,434 721,434 723,434 725,434 758,444 771,444 854,434 856,434 1141,446 1155,446 1168,436 1298,436 1331,448 1331,487 1329,500 1002,506 1000,506 998,506 973,496 945,506 942,506 940,506 825,494 661,504 620,494 529,504 516,494 502,494 405,502 299,492 283,492 275,500 275,502 270,502 270,504 113,504 111,502 59,489 62,481 62,440 535,444"/>
        <Baseline points="62,481 1331,487"/>
        <TextEquiv>
          <Unicode>Gegentheile, von nun an antwortet Er auf keine Frage mehr, als Einer,</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_024099cc" >
        <Coords points="59,494 1331,502 1331,541 1329,549 893,560 891,560 57,547 59,537"/>
        <Baseline points="59,537 1331,541"/>
        <TextEquiv>
          <Unicode>der Alles und klar genug geſagt hat. Wie ein Lamm, das, zur Schlacht⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_ec2811c5" >
        <Coords points="59,547 1337,558 1337,599 1335,611 130,614 128,614 57,601 59,593"/>
        <Baseline points="59,593 1337,599"/>
        <TextEquiv>
          <Unicode>bank geführt, ſeinen Mund nicht öffnet, geht Chriſtus, nachdem Er die</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_fae77540" >
        <Coords points="55,618 80,605 82,605 84,605 1329,614 1333,651 1329,671 59,667 62,655"/>
        <Baseline points="62,655 1333,651"/>
        <TextEquiv>
          <Unicode>grauſamſten, ſchmachvollſten Mißhandlungen erduldet, zum ſchmählich⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_87acb578" >
        <Coords points="62,707 64,657 103,667 603,659 1335,671 1337,711 1335,719 727,729 725,729 659,719 62,719"/>
        <Baseline points="62,707 1337,711"/>
        <TextEquiv>
          <Unicode>ſten Tod, und öffnet auf dem Kreuze ſeinen Mund erſt, um ſeinen Vater</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_731c8f0c" >
        <Coords points="62,769 62,719 1335,729 1335,769 1335,777 62,779"/>
        <Baseline points="62,769 1335,769"/>
        <TextEquiv>
          <Unicode>für ſeine Feinde um Vergebung zu bitten. Dem armen Schächer ver⸗</Unicode>
        </TextEquiv>
      </TextLine>
      <TextLine id="eSc_line_cd5d0886" >
